# ==============================================================================
# SmartLib Environment Configuration Example
# Copy this file to your local setup or set these environment variables in your OS
# Never commit real passwords or production credentials to version control
# ==============================================================================

# Database Connection Details
DB_HOST=localhost
DB_PORT=3306
DB_NAME=smartlib_db
DB_USERNAME=root
DB_PASSWORD=your_secure_mysql_password_here

# Application Server Port (Defaults to 8080)
SERVER_PORT=8080

# Logging Level (INFO, DEBUG, TRACE)
LOG_LEVEL=INFO
